{
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "./src",
        "module": "es2022",
        "moduleResolution": "bundler",
        "target": "es2022",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "declaration": true
    },
    "include": ["src/**/*"]
}
